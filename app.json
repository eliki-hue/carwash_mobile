{
  "expo": {
    "name": "Car Wash Manager",
    "slug": "carwash-system",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "carwashmobile",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.eliki.carwash",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "909b5d35-98ac-48fc-a655-f0cb2c995b46"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "kiragueli"
  }
}
